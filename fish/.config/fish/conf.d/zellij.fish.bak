# ╔═══════════════════════════════════════════════════════╗
# ║                    zellij.fish                        ║
# ║           Zellij auto-start / auto-exit               ║
# ╚═══════════════════════════════════════════════════════╝
# To enable auto-attach or auto-exit, set these vars before
# sourcing this file (e.g. in secret.fish or env.fish):
#
#   set -gx ZELLIJ_AUTO_ATTACH true
#   set -gx ZELLIJ_AUTO_EXIT   true

if status is-interactive
    if not set -q ZELLIJ; and not set -q INSIDE_ZED; and not set -q _ZELLIJ_AUTOSTART_GUARD
        set -gx _ZELLIJ_AUTOSTART_GUARD 1

        if test "$ZELLIJ_AUTO_ATTACH" = true
            zellij attach -c
        else
            zellij
        end

        set -e _ZELLIJ_AUTOSTART_GUARD

        if test "$ZELLIJ_AUTO_EXIT" = true
            kill $fish_pid
        end
    end
end
