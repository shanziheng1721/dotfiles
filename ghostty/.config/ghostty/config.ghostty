# Config generated by Ghostty Config

# general
quit-after-last-window-closed = true

# background
background = #000000
background-image = ~/.config/ghostty/background.jpg
background-image-fit = stretch
background-image-opacity = 0.4
background-opacity = 1.0

# font
font-family = CaskaydiaCove Nerd Font
font-size = 16

# macOS
macos-icon = xray
macos-option-as-alt = true

# mouse
mouse-hide-while-typing = true

# shader
custom-shader = ./shaders/cursor_blaze.glsl
custom-shader = ./shaders/slash.glsl
custom-shader = ./shaders/sparks.glsl

# theme
theme = One Double Dark

# window
fullscreen = true
maximize = true
window-subtitle = working-directory
window-theme = ghostty
